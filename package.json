{
  "name": "larum-property-experience",
  "version": "2.1.0",
  "private": true,
  "description": "Larum Property Experience — private prototype. Static experience plus a grounded property concierge.",
  "scripts": {
    "build": "node build-pack.js",
    "validate": "node validate-content.js",
    "seed": "node tools/generate-seed.js",
    "check": "node build-pack.js && node validate-content.js",
    "test:lpe-01": "node tests/lpe-01-schemas.test.js",
    "test:lpe-02": "node tests/lpe-02-manifest.test.js",
    "test:lpe-03": "node tests/lpe-03-shell.test.js",
    "test:lpe-04": "node tests/lpe-04-modules.test.js",
    "test:lpe-05": "node tests/lpe-05-families.test.js",
    "test:lpe-06": "node tests/lpe-06-assets.test.js",
    "test:lpe-07": "node tests/lpe-07-readiness.test.js",
    "test:lpe-08": "node tests/lpe-08-lazy.test.js",
    "test:lpe-09": "node tests/lpe-09-revisions.test.mjs",
    "test:lpe-10": "node tests/lpe-10-analytics.test.js",
    "test:lpe-11": "node tests/lpe-11-villa.test.js",
    "test:lpe-12:gates": "node tests/lpe-12-gates.test.js",
    "test:lpe-12:smoke": "npx playwright test tests/e2e/smoke/smoke.spec.js",
    "test:lpe-12:a11y": "npx playwright test tests/e2e/smoke/a11y.spec.js",
    "test:lpe-12:perf": "node tests/lpe-12-lighthouse.js",
    "test:lpe-12": "node tests/lpe-12-gates.test.js && npx playwright test tests/e2e/smoke/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.13.0",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1"
  }
}
